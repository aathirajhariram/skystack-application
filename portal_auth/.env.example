# ---- Customer-facing API ----
SKY_VIEWERS_VAULT_URL=https://kv-skystack-viewers.vault.azure.net/       # VIEWERS vault: portal users' password hashes only
SKY_DEVELOPERS_VAULT_URL=https://kv-skystack-developers.vault.azure.net/ # DEVELOPERS vault: jwt key, smtp, stripe keys, client DB credentials
SKY_CONTROL_DB_SERVER=<server>.database.windows.net
SKY_CONTROL_DB_NAME=skystack_control
SKY_STORAGE_ACCOUNT=<storage-account>
SKY_PORTAL_BASE_URL=https://www.skystack.global
SKY_CORS_ORIGINS=["https://www.skystack.global"]
SKY_COOKIE_SECURE=true

SKY_BUSINESS_EMAIL=billing@skystack.global   # gets: new subscription requests, payments received, activation problems

# ---- Internal Ops service only (separate deployment, privileged identity) ----
SKY_ENABLE_OPS=false
SKY_ENTRA_TENANT_ID=
SKY_ENTRA_AUDIENCE=
SKY_PROVISION_DB=false
SKY_TARGET_SQL_SERVER_NAME=
SKY_TARGET_SQL_SERVER_FQDN=
SKY_SUBSCRIPTION_ID=
SKY_RESOURCE_GROUP=
SKY_API_IDENTITY_NAME=       # display name of the customer API's managed identity (gets db_datareader)
SKY_DEV_TARGET_DATABASE=     # used when SKY_PROVISION_DB=false
SKY_DEV_ETL_SECRET_NAME=
